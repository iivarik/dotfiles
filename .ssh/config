# Hosts live in ~/.ssh/config.d/ (one file per host, not in this repo).
# Included first: ssh uses the first value it finds, so host files override the defaults below.
Include config.d/*

Host *
  # Load keys into ssh-agent on first use, if an agent is running
  AddKeysToAgent yes
  # Detect dead connections instead of hanging (~3 min)
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # Reuse one connection per host: faster repeat ssh/scp/git, one auth prompt
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
